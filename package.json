{
  "name": "capacitor-plugin-apple-maps",
  "version": "0.7.1",
  "description": "Capacitor plugin rendering native Apple Maps (MapKit) on iOS, API-compatible with @capacitor/google-maps.",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "dist/",
    "ios/Sources",
    "ios/Tests",
    "Package.swift",
    "CapacitorPluginAppleMaps.podspec",
    "CHANGELOG.md"
  ],
  "author": {
    "name": "pjaudiomv",
    "email": "engineering@katamalabs.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katamalabs/capacitor-plugin-apple-maps.git"
  },
  "bugs": {
    "url": "https://github.com/katamalabs/capacitor-plugin-apple-maps/issues"
  },
  "keywords": [
    "capacitor",
    "capacitor-plugin",
    "plugin",
    "native",
    "ios",
    "apple-maps",
    "applemaps",
    "mapkit",
    "maps",
    "map",
    "google-maps",
    "ionic",
    "cordova"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:web",
    "verify:ios": "xcodebuild -scheme CapacitorPluginAppleMaps -destination generic/platform=iOS",
    "verify:web": "npm run build",
    "test": "npm run test:web && npm run test:ios",
    "test:web": "vitest run",
    "test:web:watch": "vitest",
    "test:ios": "bash scripts/test-ios.sh",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js}\"",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api CapacitorAppleMapsPlugin --output-readme README.md --output-json dist/docs.json",
    "docs:site": "node scripts/build-docs.mjs",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "shipit": "np",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate"
  },
  "devDependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^8.0.0",
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "all-contributors-cli": "^6.26.1",
    "eslint": "^8.57.1",
    "marked": "^18.0.11",
    "np": "^12.0.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "rollup": "^4.53.2",
    "swiftlint": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    }
  }
}
