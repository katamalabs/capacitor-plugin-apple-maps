{
  "name": "capacitor-plugin-apple-maps-example",
  "version": "1.0.0",
  "description": "Minimal Svelte + Capacitor demo: Apple Maps on iOS, Google Maps on Android/web, behind one shared API.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync": "cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "ios": "npm run build && cap sync ios && cap open ios",
    "android": "npm run build && cap sync android && cap open android",
    "sim:ios": "npm run build && cap run ios",
    "sim:android": "npm run build && cap run android",
    "run:ios": "cap run ios",
    "run:android": "cap run android",
    "targets:ios": "cap run ios --list",
    "targets:android": "cap run android --list"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/google-maps": "^8.0.1",
    "@capacitor/ios": "^8.5.0",
    "capacitor-plugin-apple-maps": "file:.."
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.19.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.1"
  }
}
